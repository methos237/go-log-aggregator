-- query
{service="api"} | rate(1m)
-- source
logs_rate_1m
-- streams
SELECT stream_id FROM streams WHERE service = $1
-- streams args
string "api"
-- logs
SELECT time_bucket($4::interval, bucket) AS bucket, sum(n)::float8 / $5 FROM logs_rate_1m WHERE stream_id = ANY($1) AND bucket >= $2 AND bucket < $3 GROUP BY 1 ORDER BY 1 ASC LIMIT $6
-- logs args
[]int64 []int64(nil)
time.Time time.Date(2026, time.September, 1, 0, 0, 0, 0, time.UTC)
time.Time time.Date(2026, time.September, 1, 1, 0, 0, 0, time.UTC)
time.Duration 60000000000
float64 60
int 100
