-- query
{shard>="10"}
-- source
logs
-- streams
SELECT stream_id FROM streams WHERE coalesce(labels ->> $1, '') >= $2
-- streams args
string "shard"
string "10"
-- logs
SELECT time, stream_id, seq, level, message, trace_id, span_id, fields FROM logs WHERE stream_id = ANY($1) AND time >= $2 AND time < $3 ORDER BY time DESC, seq DESC LIMIT $4
-- logs args
[]int64 []int64(nil)
time.Time time.Date(2026, time.September, 1, 0, 0, 0, 0, time.UTC)
time.Time time.Date(2026, time.September, 1, 1, 0, 0, 0, time.UTC)
int 100
