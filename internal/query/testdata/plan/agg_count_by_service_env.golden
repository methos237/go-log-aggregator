-- query
{env="prod"} | count_over_time(1h) by (service, env)
-- source
logs_rate_1h
-- streams
SELECT stream_id FROM streams WHERE env = $1
-- streams args
string "prod"
-- logs
SELECT time_bucket($4::interval, bucket) AS bucket, sum(n)::float8, (service) COLLATE "C", (env) COLLATE "C" FROM logs_rate_1h JOIN streams USING (stream_id) WHERE stream_id = ANY($1) AND bucket >= $2 AND bucket < $3 GROUP BY 1, 3, 4 ORDER BY 1 DESC, 3, 4 LIMIT $5
-- logs args
[]int64 []int64(nil)
time.Time time.Date(2026, time.September, 1, 0, 0, 0, 0, time.UTC)
time.Time time.Date(2026, time.September, 1, 1, 0, 0, 0, time.UTC)
time.Duration 3600000000000
int 100
