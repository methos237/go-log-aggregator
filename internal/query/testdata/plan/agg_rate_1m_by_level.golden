-- query
{service="api", level>="warn"} | rate(5m) by (level)
-- source
logs_rate_1m
-- streams
SELECT stream_id FROM streams WHERE service = $1
-- streams args
string "api"
-- logs
SELECT time_bucket($5::interval, bucket) AS bucket, sum(n)::float8 / $6, level FROM logs_rate_1m WHERE stream_id = ANY($1) AND bucket >= $2 AND bucket < $3 AND level >= $4 GROUP BY 1, 3 ORDER BY 1 DESC, 3 LIMIT $7
-- logs args
[]int64 []int64(nil)
time.Time time.Date(2026, time.September, 1, 0, 0, 0, 0, time.UTC)
time.Time time.Date(2026, time.September, 1, 1, 0, 0, 0, time.UTC)
int16 4
time.Duration 300000000000
float64 300
int 100
