# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.*

# Build output
bin/
dist/

# Binaries a bare `go build ./cmd/<name>` drops in the repo root. Named
# individually rather than by a wildcard: a pattern broad enough to catch these
# also catches directories like cmd/ and internal/.
/agent
/collector
/loadgen
/logctl

# Profiles from `make bench` / pprof
*.prof
*.pprof

# TLS material for local development. Never commit keys or certificates, even
# self-signed ones: it teaches the habit of committing them.
certs/
*.pem
*.key
*.crt

# Editor/IDE
.idea/
# .vscode/

# rapid writes a reproducer here when a property test fails; it is scratch, not a fixture.
**/testdata/rapid/

# graphify knowledge-graph output; regenerate with /graphify
graphify-out/
