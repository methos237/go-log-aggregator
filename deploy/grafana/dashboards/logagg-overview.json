    {
      "id": 14,
      "type": "timeseries",
      "title": "In-process queue depth",
      "description": "Records waiting in each bounded in-process queue. A full queue is what sheds: the ingest one answers OVERLOADED, the writer one naks.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (queue) (logagg_queue_depth)",
          "legendFormat": "{{queue}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
